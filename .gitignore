# Python / tooling
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated datasets are written and committed by CI (scripts/fetch_official.py
# and scripts/build_datasets.py). They are force-added by the pipeline so that
# local commits never conflict with a CI refresh. Every dataset row carries
# the official source URL it was read from, and data/datasets/manifest.json
# records the provenance hash of each source payload.

# Raw official-source cache (regenerated by CI; provenance hash kept in
# data/datasets/manifest.json so the committed datasets stay auditable)
data/raw/*.html
data/raw/*.json
data/raw/*.txt
!data/raw/.gitkeep
data/datasets/

# OS noise
.DS_Store
Thumbs.db
data/raw/
scripts/fixtures/
